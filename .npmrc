# Registry routing ONLY. No tokens and no ${VARS} here:
# pnpm 11.5.3+ ignores env-var placeholders in a repo .npmrc (protects CI secrets).
# Tokens go in your user config:  pnpm config set "//<host>/<path>/:_authToken" "<token>"
# Replace YOUR-COMPANY / lds-npm with the values from the JFrog admin.

@tmna-cx-design-system:registry=https://YOUR-COMPANY.jfrog.io/artifactory/api/npm/lds-npm/
@tmna-cx-ds-organisms:registry=https://YOUR-COMPANY.jfrog.io/artifactory/api/npm/lds-npm/

# Optional: route ALL public packages through a JFrog virtual repo too
# registry=https://YOUR-COMPANY.jfrog.io/artifactory/api/npm/npm-virtual/
