{
  "name": "@tmna-cx-design-system/react",
  "version": "0.0.0",
  "description": "React components for LDS: thin typed wrappers generated from the web components",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "registry": "https://YOUR-COMPANY.jfrog.io/artifactory/api/npm/lds-npm/"
  },
  "dependencies": {
    "@stencil/react-output-target": "catalog:",
    "@tmna-cx-design-system/web-components": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "nx": {
    "tags": [
      "type:wrapper",
      "framework:react"
    ]
  }
}
