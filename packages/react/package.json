{
  "name": "@tmna-cx-design-system/react",
  "version": "0.0.0",
  "description": "React components for LDS: thin typed wrappers generated from the web components",
  "license": "UNLICENSED",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@stencil/react-output-target": "catalog:",
    "@tmna-cx-design-system/web-components": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.3.0 || ^19.0.0",
    "react-dom": "^18.3.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "playwright": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:wrapper",
      "framework:react"
    ],
    "targets": {
      "test": {
        "command": "vitest run",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "^build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [],
        "cache": true
      },
      "build": {
        "options": {
          "command": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc --build tsconfig.lib.json"
        }
      }
    }
  }
}
