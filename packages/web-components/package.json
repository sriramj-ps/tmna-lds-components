{
  "name": "@tmna-cx-design-system/web-components",
  "version": "0.0.0",
  "description": "LDS components as framework-agnostic web components (Stencil). Works in AEM HTL, React and Angular.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/types/index.d.ts",
  "collection": "./dist/collection/collection-manifest.json",
  "collection:main": "./dist/collection/index.js",
  "unpkg": "./dist/lds/lds.esm.js",
  "files": [
    "dist",
    "loader",
    "components"
  ],
  "sideEffects": [
    "./dist/lds/*",
    "./loader/*",
    "./components/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js"
    },
    "./components": {
      "types": "./components/index.d.ts",
      "import": "./components/index.js"
    },
    "./components/*.js": {
      "types": "./components/*.d.ts",
      "import": "./components/*.js"
    },
    "./components/*": {
      "types": "./components/*.d.ts",
      "import": "./components/*.js"
    },
    "./docs.json": "./dist/docs.json",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "./dist/custom-elements.json",
  "peerDependencies": {
    "@tmna-cx-design-system/styles": "workspace:^"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "catalog:",
    "@stencil/core": "catalog:",
    "@stencil/react-output-target": "catalog:",
    "@storybook/web-components-vite": "catalog:",
    "@vitest/browser": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "lit": "catalog:",
    "playwright": "catalog:",
    "storybook": "catalog:",
    "vitest": "catalog:"
  },
  "nx": {
    "tags": [
      "type:components",
      "level:core"
    ],
    "targets": {
      "build": {
        "executor": "nx:run-commands",
        "options": {
          "cwd": "{projectRoot}",
          "commands": [
            "node -e \"for (const d of ['../react/src/generated', '../angular/src/generated']) require('node:fs').rmSync(d, { recursive: true, force: true })\"",
            "stencil build"
          ],
          "parallel": false
        },
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": [
          "{projectRoot}/dist",
          "{projectRoot}/loader",
          "{projectRoot}/components",
          "{projectRoot}/src/components.d.ts",
          "{workspaceRoot}/packages/react/src/generated",
          "{workspaceRoot}/packages/angular/src/generated"
        ],
        "cache": true
      },
      "dev": {
        "command": "stencil build --dev --watch",
        "options": {
          "cwd": "{projectRoot}"
        },
        "continuous": true
      },
      "stylelint": {},
      "typecheck": {
        "command": "tsc -p tsconfig.json --noEmit",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "production",
          "^production"
        ],
        "outputs": []
      },
      "test": {
        "command": "vitest run",
        "options": {
          "cwd": "{projectRoot}"
        },
        "dependsOn": [
          "build"
        ],
        "inputs": [
          "default",
          "^production"
        ],
        "outputs": [],
        "cache": true
      },
      "publint": {}
    }
  },
  "engines": {
    "node": ">=20"
  }
}
