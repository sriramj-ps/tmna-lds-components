{
  "color": {
    "$description": "Lexus brand mode: same token NAMES as Toyota, different VALUES. Mirrors the 'Lexus' mode of the Figma variable collection.",
    "$type": "color",
    "text": {
      "default": {
        "$value": "{palette.neutral.1000}"
      },
      "subtle": {
        "$value": "{palette.neutral.700}"
      },
      "inverse": {
        "$value": "{palette.neutral.0}"
      }
    },
    "surface": {
      "default": {
        "$value": "{palette.neutral.0}"
      },
      "raised": {
        "$value": "{palette.neutral.100}"
      }
    },
    "border": {
      "default": {
        "$value": "{palette.neutral.300}"
      }
    },
    "action": {
      "primary": {
        "background": {
          "$value": "{palette.neutral.1000}"
        },
        "background-hover": {
          "$value": "{palette.neutral.900}"
        },
        "foreground": {
          "$value": "{palette.neutral.0}"
        }
      }
    },
    "focus": {
      "ring": {
        "$value": "{palette.blue.500}"
      }
    }
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "body": {
        "$value": ["Nobel", "Helvetica Neue", "Arial", "sans-serif"]
      }
    }
  },
  "shape": {
    "$type": "dimension",
    "action-radius": {
      "$value": "{radius.none}"
    }
  }
}
