/* Tokens only: Stylelint rejects raw colours, sizes and fonts. */
:host {
  display: block;
}

.container {
  padding: var(--lds-space-4);
  font-family: var(--lds-font-family-body);
  color: var(--lds-color-text-default);
  background-color: var(--lds-color-surface-default);
}

.container--subtle {
  background-color: var(--lds-color-surface-raised);
}
